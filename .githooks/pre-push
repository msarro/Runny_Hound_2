#!/bin/sh
# Refuses pushes to main and runs every pipeline check before anything leaves this computer.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct pushes to main are not allowed. Push a branch and open a pull request." >&2
    exit 1
  fi
done
npm run check
